# Moodle Database Configuration
MOODLE_DB_ROOT_PASSWORD=change_this_root_password
MOODLE_DB_PASSWORD=change_this_user_password

# Moodle Docker Configuration
MOODLE_DOCKER_PHP_VERSION=8.3
MOODLE_DOCKER_DB_VERSION=11.4
MOODLE_DOCKER_WEB_HOST=127.0.0.1
MOODLE_DOCKER_WEB_PORT=8080

# Moodle Source and Docker Assets
MOODLE_DOCKER_WWWROOT=../moodle-source
ASSETDIR=../moodle-docker-source/assets
MOODLE_DOCKER_TIMEOUT_FACTOR=1
MOODLE_DOCKER_BROWSER_TAG=latest
